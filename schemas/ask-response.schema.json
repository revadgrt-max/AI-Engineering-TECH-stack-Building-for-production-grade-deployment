{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/ask-response.schema.json",
  "title": "Ask Response",
  "description": "Response body for GET /ask.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "answer",
    "sources",
    "confidence",
    "model",
    "tokens_used"
  ],
  "properties": {
    "answer": {
      "type": "string",
      "description": "The generated answer."
    },
    "sources": {
      "type": "array",
      "description": "Sources used to produce the answer.",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Model self-assessment between 0 and 1; not a calibrated probability."
    },
    "model": {
      "type": "string",
      "minLength": 1,
      "description": "Model used to generate the answer."
    },
    "tokens_used": {
      "type": "integer",
      "minimum": 0,
      "description": "Total number of tokens used."
    }
  }
}
